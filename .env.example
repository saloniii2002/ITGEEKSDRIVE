# Groq Vision LLM API Key (Required for live AI bill extraction)
GROQ_API_KEY=your_groq_api_key_here

# Groq Vision & Text Models (Using Qwen 3.8 Vision and OpenAI GPT-OSS on Groq)
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_TEXT_MODEL=openai/gpt-oss-120b

# Fallback Vision Provider (Optional - only if configured)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Database
DATABASE_URL=sqlite:///./bills.db

# App URLs
BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Force mock extractor for offline/testing mode (true/false)
FORCE_MOCK_EXTRACTOR=false
