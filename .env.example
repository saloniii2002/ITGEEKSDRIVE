# Groq Vision LLM API Key (Required for live AI bill extraction)
GROQ_API_KEY=your_groq_api_key_here

# Groq Vision Model (default: llama-3.2-11b-vision-preview or meta-llama/llama-4-scout-17b-16e-instruct)
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview
GROQ_TEXT_MODEL=llama-3.3-70b-versatile

# Fallback Vision Provider (Optional - only if configured)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Database
DATABASE_URL=sqlite:///./bills.db

# App URLs
BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Force mock extractor for offline/testing mode (true/false)
FORCE_MOCK_EXTRACTOR=false
